# Copy this file to .env. Never commit the real .env file.
# Non-secret model chains and budgets live in api.yaml; values below are optional overrides.
QWEN_API_KEY=
QWEN_BASE_URL=https://ws-your-endpoint.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Cloud calls are opt-in so a local test never spends quota by accident.
CLOUD_LLM_ENABLED=false
# QWEN_MODEL_CHAIN=
# QWEN_MAX_CALLS_PER_VIDEO=1
# QWEN_MAX_INPUT_CHARS=8000
# QWEN_MAX_OUTPUT_TOKENS=2500

# Available cloud ASR. It remains disabled until its short-clip evaluation.
CLOUD_ASR_ENABLED=false
FUN_ASR_MODEL=fun-asr-flash-2026-06-15

# Optional future local llama.cpp/OpenAI-compatible endpoint.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=Qwen3-8B-Q4_K_M

# Optional Windows CUDA DLL directories (separate multiple paths with semicolons).
# Usually unnecessary when a GPU-enabled Conda environment is activated first.
VIDEO_STUDY_CUDA_DLL_DIRS=

# Optional Qwen3-ASR runtime overrides.
# QWEN_ASR_RUNTIME_PYTHON=D:/Anaconda/envs/envs/ImageT10/python.exe

# Optional Qwen3-ASR runtime overrides.
# QWEN_ASR_RUNTIME_PYTHON=D:/Anaconda/envs/envs/ImageT10/python.exe
