# Copy this file to .env and fill only machine-local values.
# Never commit .env. Model defaults and budgets belong in api.yaml.
QWEN_API_KEY=
QWEN_BASE_URL=

# Cloud inference remains opt-in.
CLOUD_LLM_ENABLED=false
# QWEN_MODEL_CHAIN=

# Optional Windows CUDA DLL directories (separate multiple paths with semicolons).
VIDEO_STUDY_CUDA_DLL_DIRS=

# Optional local Qwen3-ASR runtime override.
# QWEN_ASR_RUNTIME_PYTHON=D:/Anaconda/envs/envs/ImageT10/python.exe
